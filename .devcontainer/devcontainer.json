{
  "name": "Secure Student Dev Sandbox",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "ms-python.python"
      ]
    }
  },

  // Security: Run as an unprivileged user, NOT root
  "remoteUser": "vscode",

  // Security: Prevent container processes from acquiring new privileges
  "runArgs": [
    "--security-opt", "no-new-privileges:true"
  ],

  // Automatically install required course packages upon first creation
  "postCreateCommand": "pip install --upgrade pip && pip install jupyter pandas numpy requests"
}
